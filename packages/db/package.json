{
  "name": "@packages/db",
  "version": "1.0.0",
  "private": true,
  "exports": {
    ".": "./src/index.ts"
  },
  "types": "./src/index.ts",
  "scripts": {
    "check:type": "tsgo --noEmit",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:reset": "prisma migrate reset --force",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "db:generate": "prisma generate",
    "db:generate:fabbrica": "prisma generate --generator fabbrica",
    "clean": "rm -rf src/generated",
    "build": "echo 'No build step needed (TypeScript source directly used)'"
  },
  "packageManager": "bun@1.3.5",
  "dependencies": {
    "@packages/logger": "workspace:*",
    "@prisma/adapter-pg": "7.1.0",
    "@prisma/client": "7.1.0",
    "prisma": "^7.1.0"
  },
  "devDependencies": {
    "@quramy/prisma-fabbrica": "^2.3.3",
    "@types/bun": "latest"
  }
}
