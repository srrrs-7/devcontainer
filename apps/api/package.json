    "bcrypt": "^6.0.0",
    "dayjs": "^1.11.19",
    "hono": "4.11.5",
    "jose": "^6.1.3",
    "neverthrow": "^8.0.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@chax-at/transactional-prisma-testing": "1.4.2",
    "@types/bcrypt": "^6.0.0",
    "@types/bun": "^1.3.0",
    "vitest": "4.0.15"
  }
